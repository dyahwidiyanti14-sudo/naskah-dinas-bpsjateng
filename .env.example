# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=ganti_dengan_string_acak_panjang

# Google Service Account JSON key, di-encode base64 (lihat README bagian "Setup Google Cloud")
# Cara generate: base64 -i service-account.json  (mac/linux)
#                certutil -encode service-account.json service-account.b64  (windows, lalu buang header/footer)
GOOGLE_SERVICE_ACCOUNT_KEY=

# OPSIONAL: alternatif untuk config/teams.json di deployment Vercel
# (isi dengan seluruh isi teams.json dalam satu baris JSON string)
# TEAMS_CONFIG_JSON=
